# Copy this file to .env.local and replace the local database password.
# Keep .env.local private; it is ignored by Git.
DATABASE_URL=postgresql://postgres:replace-with-local-password@127.0.0.1:5432/interior_design
PAYLOAD_SECRET=replace-with-a-random-secret-at-least-32-characters-long
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAYLOAD_STORAGE=local
# Optional: max DB connections per process (default 10).
# DB_POOL_MAX=10

# For S3 media storage, set PAYLOAD_STORAGE=s3 and configure:
# AWS_REGION=us-east-1
# S3_BUCKET=your-media-bucket
# S3_PREFIX=media
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# ASSET_CDN_URL=https://your-cloudfront-domain.example
#
# On AWS, prefer an ECS task role and leave access keys unset. For local or
# external hosting, inject both values from a secrets manager:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
